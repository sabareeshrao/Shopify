    "package com.salesmanager.shop.store.api.v1.security;",
    "",
    "import java.util.ArrayList;",
    "import java.util.List;",
    "import java.util.Set;",
    "",
    "import javax.inject.Inject;",
    "",
    "import org.slf4j.Logger;",
    "import org.slf4j.LoggerFactory;",
    "import org.springframework.http.HttpStatus;",
    "import org.springframework.http.MediaType;",
    "import org.springframework.web.bind.annotation.GetMapping;",
    "import org.springframework.web.bind.annotation.PathVariable;",
    "import org.springframework.web.bind.annotation.RequestMapping;",
    "import org.springframework.web.bind.annotation.ResponseStatus;",
    "import org.springframework.web.bind.annotation.RestController;",
    "",
    "import com.salesmanager.core.business.services.user.GroupService;",
    "import com.salesmanager.core.business.services.user.PermissionService;",
    "import com.salesmanager.core.model.user.Group;",
    "import com.salesmanager.core.model.user.Permission;",
    "import com.salesmanager.shop.model.security.ReadableGroup;",
    "import com.salesmanager.shop.model.security.ReadablePermission;",
    "import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;",
    "import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;",
    "",
    "import io.swagger.annotations.Api;",
    "import io.swagger.annotations.ApiOperation;",
    "import io.swagger.annotations.SwaggerDefinition;",
    "import io.swagger.annotations.Tag;",
    "",
    "/**",
    " * Api for managing security",
    " * ",
    " * @author carlsamson",
    " *",
    " */",
    "@RestController",
    "@RequestMapping(value = \"/api/v1/sec\")",
    "@Api(tags = { \"Groups and permissions Api\" })",
    "@SwaggerDefinition(tags = {",
    "\t\t@Tag(name = \"List of supported groups and permissions\", description = \"List groups and attached permissions for reference\") })",
    "public class SecurityApi {",
    "",
    "\tprivate static final Logger LOGGER = LoggerFactory.getLogger(SecurityApi.class);",
    "",
    "\t@Inject",
    "\tprivate PermissionService permissionService;",
    "",
    "\t@Inject",
    "\tprivate GroupService groupService;",
    "",
    "\t@ResponseStatus(HttpStatus.OK)",
    "\t@GetMapping({ \"/private/{group}/permissions\" })",
    "\t@ApiOperation(httpMethod = \"GET\", value = \"Get permissions by group\", notes = \"\", produces = MediaType.APPLICATION_JSON_VALUE, response = List.class)",
    "\tpublic List<ReadablePermission> listPermissions(@PathVariable String group) {",
    "",
    "\t\tGroup g = null;",
    "\t\ttry {",
    "\t\t\tg = groupService.findByName(group);",
    "\t\t\tif(g == null) {",
    "\t\t\t\tthrow new ResourceNotFoundException(\"Group [\" + group + \"] does not exist\");",
    "\t\t\t}",
    "\t\t} catch (Exception e) {",
    "\t\t\tLOGGER.error(\"An error occured while getting group [\" + group + \"]\",e);",
    "\t\t\tthrow new ServiceRuntimeException(\"An error occured while getting group [\" + group + \"]\");",
    "\t\t}",
    "\t\tSet<Permission> permissions = g.getPermissions();",
    "\t\tList<ReadablePermission> readablePermissions = new ArrayList<ReadablePermission>();",
    "\t\tfor (Permission permission : permissions) {",
    "\t\t\tReadablePermission readablePermission = new ReadablePermission();",
    "\t\t\treadablePermission.setName(permission.getPermissionName());",
    "\t\t\treadablePermission.setId(permission.getId());",
    "\t\t\treadablePermissions.add(readablePermission);",
    "\t\t}",
    "\t\treturn readablePermissions;",
    "",
    "\t\t",
    "\t}",
    "",
    "\t/**",
    "\t * Permissions Requires service user authentication",
    "\t * ",
    "\t * @return",
    "\t */",
    "\t@GetMapping(\"/private/permissions\")",
    "\tpublic List<ReadablePermission> permissions() {",
    "\t\tList<Permission> permissions = permissionService.list();",
    "\t\tList<ReadablePermission> readablePermissions = new ArrayList<ReadablePermission>();",
    "\t\tfor (Permission permission : permissions) {",
    "\t\t\tReadablePermission readablePermission = new ReadablePermission();",
    "\t\t\treadablePermission.setName(permission.getPermissionName());",
    "\t\t\treadablePermission.setId(permission.getId());",
    "\t\t\treadablePermissions.add(readablePermission);",
    "\t\t}",
    "\t\treturn readablePermissions;",
    "\t}",
    "",
    "\t/**",
    "\t * Load groups Requires service user authentication",
    "\t * ",
    "\t * @return",
    "\t */",
    "\t@GetMapping(\"/private/groups\")",
    "\tpublic List<ReadableGroup> groups() {",
    "\t\tList<Group> groups = groupService.list();",
    "\t\tList<ReadableGroup> readableGroups = new ArrayList<ReadableGroup>();",
    "\t\tfor (Group group : groups) {",
    "\t\t\tReadableGroup readableGroup = new ReadableGroup();",
    "\t\t\treadableGroup.setName(group.getGroupName());",
    "\t\t\treadableGroup.setId(group.getId().longValue());",
    "\t\t\treadableGroup.setType(group.getGroupType().name());",
    "\t\t\treadableGroups.add(readableGroup);",
    "\t\t}",
    "\t\treturn readableGroups;",
    "\t}",
    "",
    "}"
  ]
}
