    "package com.salesmanager.shop.store.security.admin;",
    "",
    "import java.io.IOException;",
    "",
    "import javax.servlet.ServletException;",
    "import javax.servlet.http.HttpServletRequest;",
    "import javax.servlet.http.HttpServletResponse;",
    "",
    "import org.springframework.security.access.AccessDeniedException;",
    "import org.springframework.security.web.access.AccessDeniedHandler;",
    "",
    "public class AdminAccessDeniedHandler implements AccessDeniedHandler {",
    "",
    "\t@Override",
    "\tpublic void handle(HttpServletRequest request,",
    "\t\t\tHttpServletResponse response,",
    "\t\t\tAccessDeniedException accessDeniedException) throws IOException,",
    "\t\t\tServletException {",
    "\t\tresponse.sendRedirect(request.getContextPath() + getAccessDeniedUrl());",
    "",
    "\t}",
    "\t",
    "\tpublic String getAccessDeniedUrl() {",
    "\t\treturn accessDeniedUrl;",
    "\t}",
    "",
    "\tpublic void setAccessDeniedUrl(String accessDeniedUrl) {",
    "\t\tthis.accessDeniedUrl = accessDeniedUrl;",
    "\t}",
    "",
    "\tprivate String accessDeniedUrl = null;",
    "",
    "}"
  ]
}
