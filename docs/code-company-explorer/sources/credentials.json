    "package com.salesmanager.shop.store.security.services;",
    "",
    "import org.apache.commons.lang3.StringUtils;",
    "import org.passay.CharacterRule;",
    "import org.passay.EnglishCharacterData;",
    "import org.passay.LengthRule;",
    "import org.passay.PasswordData;",
    "import org.passay.PasswordValidator;",
    "import org.passay.RuleResult;",
    "",
    "import com.salesmanager.core.model.merchant.MerchantStore;",
    "import com.salesmanager.core.model.reference.language.Language;",
    "",
    "/**",
    " * Internal credentials service",
    " * @author carlsamson",
    " *",
    " */",
    "public class CredentialsServiceImpl implements CredentialsService {",
    "",
    "\t@Override",
    "\tpublic void validateCredentials(String password, String repeatPassword, MerchantStore store, Language language)",
    "\t\t\tthrows CredentialsException {",
    "\t\t",
    "\t\tif(StringUtils.isBlank(password) || StringUtils.isBlank(repeatPassword) ) {",
    "\t\t\tthrow new CredentialsException(\"Empty password not supported\");",
    "\t\t}",
    "\t\t",
    "\t\t/**",
    "\t\t * validate - both password match",
    "\t\t */",
    "\t\tif(!password.equals(repeatPassword)) {",
    "\t\t\tthrow new CredentialsException(\"Password don't match\");",
    "\t\t}",
    "\t\t",
    "\t\t//create your own rules",
    "\t\tPasswordValidator passwordValidator = new PasswordValidator(",
    "\t\t\t\t  new CharacterRule(EnglishCharacterData.Digit, 1),//at least 1 digit",
    "\t\t\t\t  new CharacterRule(EnglishCharacterData.Special, 1),// at least 1 special character",
    "\t\t\t\t  new LengthRule(8, 12)//8 to 12 characters",
    "\t\t);",
    "\t\t",
    "\t      PasswordData passwordData = new PasswordData(password);        ",
    "\t      RuleResult result = passwordValidator.validate(passwordData);",
    "\t        ",
    "\t      if(!result.isValid()){",
    "\t         throw new CredentialsException(\"Password validation failed [\" + passwordValidator.getMessages(result) + \"]\");",
    "\t      }",
    "",
    "\t}",
    "",
    "\t@Override",
    "\tpublic String generatePassword(MerchantStore store, Language language) throws CredentialsException {",
    "\t\t// TODO Auto-generated method stub",
    "\t\treturn null;",
    "\t}",
    "",
    "}"
  ]
}
