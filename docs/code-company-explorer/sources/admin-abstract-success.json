    "package com.salesmanager.shop.admin.security;",
    "",
    "import java.util.Date;",
    "",
    "import javax.inject.Inject;",
    "import javax.servlet.http.HttpServletRequest;",
    "import javax.servlet.http.HttpServletResponse;",
    "import javax.servlet.http.HttpSession;",
    "",
    "import org.slf4j.Logger;",
    "import org.slf4j.LoggerFactory;",
    "import org.springframework.security.core.Authentication;",
    "import org.springframework.security.core.context.SecurityContext;",
    "import org.springframework.security.core.context.SecurityContextHolder;",
    "import org.springframework.security.web.authentication.SavedRequestAwareAuthenticationSuccessHandler;",
    "",
    "import com.salesmanager.core.business.services.user.UserService;",
    "import com.salesmanager.core.model.user.User;",
    "",
    "public abstract class AbstractAuthenticatinSuccessHandler extends SavedRequestAwareAuthenticationSuccessHandler {",
    "\t",
    "\tabstract protected void redirectAfterSuccess(HttpServletRequest request, HttpServletResponse response) throws Exception;",
    "\t",
    "\tprivate static final Logger LOGGER = LoggerFactory.getLogger(AbstractAuthenticatinSuccessHandler.class);",
    "\t",
    "\t",
    "\t@Inject",
    "\tprivate UserService userService;",
    "\t",
    "\t    @Override",
    "\t    public void onAuthenticationSuccess(HttpServletRequest request, HttpServletResponse response, Authentication authentication) {",
    "\t\t  // last access timestamp",
    "\t\t  String userName = authentication.getName();",
    "\t\t  ",
    "\t\t  /**",
    "\t\t   * Spring Security 4 does not seem to add security context in the session",
    "\t\t   * creating the authentication to be lost during the login",
    "\t\t   */",
    "\t\t  SecurityContext securityContext = SecurityContextHolder.getContext();",
    "\t\t  HttpSession session = request.getSession(true);",
    "\t\t  session.setAttribute(\"SPRING_SECURITY_CONTEXT\", securityContext);",
    "\t\t  ",
    "\t\t  try {",
    "\t\t\t  User user = userService.getByUserName(userName);",
    "\t\t\t  ",
    "\t\t\t  Date lastAccess = user.getLoginTime();",
    "\t\t\t  if(lastAccess==null) {",
    "\t\t\t\t  lastAccess = new Date();",
    "\t\t\t  }",
    "\t\t\t  user.setLastAccess(lastAccess);",
    "\t\t\t  user.setLoginTime(new Date());",
    "\t\t\t  ",
    "\t\t\t  userService.saveOrUpdate(user);",
    "\t\t\t  ",
    "\t\t\t  redirectAfterSuccess(request,response);",
    "",
    "\t\t  ",
    "\t\t  } catch (Exception e) {",
    "\t\t\t  LOGGER.error(\"User authenticationSuccess\",e);",
    "\t\t  }",
    "\t\t  ",
    "",
    "\t   }",
    "",
    "}"
  ]
}
