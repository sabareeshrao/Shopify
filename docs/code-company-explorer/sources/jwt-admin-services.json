    "package com.salesmanager.shop.store.security.admin;",
    "",
    "import java.util.ArrayList;",
    "import java.util.Collection;",
    "import java.util.Date;",
    "import java.util.List;",
    "",
    "import javax.inject.Inject;",
    "",
    "import org.apache.commons.collections4.CollectionUtils;",
    "import org.slf4j.Logger;",
    "import org.slf4j.LoggerFactory;",
    "import org.springframework.security.core.GrantedAuthority;",
    "import org.springframework.security.core.authority.SimpleGrantedAuthority;",
    "import org.springframework.security.core.userdetails.UserDetails;",
    "import org.springframework.security.core.userdetails.UserDetailsService;",
    "import org.springframework.security.core.userdetails.UsernameNotFoundException;",
    "import org.springframework.stereotype.Service;",
    "",
    "import com.salesmanager.core.business.exception.ServiceException;",
    "import com.salesmanager.core.business.services.user.GroupService;",
    "import com.salesmanager.core.business.services.user.PermissionService;",
    "import com.salesmanager.core.business.services.user.UserService;",
    "import com.salesmanager.core.model.common.audit.AuditSection;",
    "import com.salesmanager.core.model.user.Group;",
    "import com.salesmanager.core.model.user.Permission;",
    "import com.salesmanager.core.model.user.User;",
    "import com.salesmanager.shop.admin.security.SecurityDataAccessException;",
    "import com.salesmanager.shop.constants.Constants;",
    "import com.salesmanager.shop.store.security.user.JWTUser;",
    "",
    "",
    "@Service(\"jwtAdminDetailsService\")",
    "public class JWTAdminServicesImpl implements UserDetailsService{",
    "\t",
    "\tprivate static final Logger LOGGER = LoggerFactory.getLogger(JWTAdminServicesImpl.class);",
    "\t",
    "\t",
    "\t@Inject",
    "\tprivate UserService userService;",
    "\t@Inject",
    "\tprivate PermissionService  permissionService;",
    "\t@Inject",
    "\tprivate GroupService   groupService;",
    "\t",
    "\tpublic final static String ROLE_PREFIX = \"ROLE_\";//Spring Security 4",
    "",
    "",
    "\tprivate UserDetails userDetails(String userName, User user, Collection<GrantedAuthority> authorities) {",
    "        ",
    "\t\tAuditSection section = null;",
    "\t\tsection = user.getAuditSection();",
    "\t\tDate lastModified = null;",
    "\t\t//if(section != null) {//does not represent password change",
    "\t\t//\tlastModified = section.getDateModified();",
    "\t\t//}",
    "\t\t",
    "\t\treturn new JWTUser(",
    "        \t\tuser.getId(),",
    "        \t\tuserName,",
    "        \t\tuser.getFirstName(),",
    "        \t\tuser.getLastName(),",
    "                user.getAdminEmail(),",
    "                user.getAdminPassword(),",
    "                authorities,",
    "                true,",
    "                lastModified",
    "        );",
    "\t}",
    "",
    "\t@Override",
    "\tpublic UserDetails loadUserByUsername(String userName) throws UsernameNotFoundException {",
    "\t\tUser user = null;",
    "\t\tCollection<GrantedAuthority> authorities = new ArrayList<GrantedAuthority>();",
    "",
    "\t\ttry {",
    "\t\t\t",
    "\t\t\t\tLOGGER.debug(\"Loading user by user id: {}\", userName);",
    "",
    "\t\t\t\tuser = userService.getByUserName(userName);",
    "\t\t\t",
    "\t\t\t\tif(user==null) {",
    "\t\t\t\t\t//return null;",
    "\t\t\t\t\tthrow new UsernameNotFoundException(\"User \" + userName + \" not found\");",
    "\t\t\t\t}",
    "",
    "\t\t\tGrantedAuthority role = new SimpleGrantedAuthority(ROLE_PREFIX + Constants.PERMISSION_AUTHENTICATED);//required to login",
    "\t\t\tauthorities.add(role); ",
    "\t\t\t",
    "\t\t\tList<Integer> groupsId = new ArrayList<Integer>();",
    "\t\t\tList<Group> groups = user.getGroups();",
    "\t\t\tfor(Group group : groups) {",
    "\t\t\t\tgroupsId.add(group.getId());",
    "\t\t\t}",
    "\t\t\t",
    "\t",
    "\t\t\tif(CollectionUtils.isNotEmpty(groupsId)) {",
    "\t\t    \tList<Permission> permissions = permissionService.getPermissions(groupsId);",
    "\t\t    \tfor(Permission permission : permissions) {",
    "\t\t    \t\tGrantedAuthority auth = new SimpleGrantedAuthority(permission.getPermissionName());",
    "\t\t    \t\tauthorities.add(auth);",
    "\t\t    \t}",
    "\t\t\t}",
    "",
    "\t\t",
    "\t\t} catch (ServiceException e) {",
    "\t\t\tLOGGER.error(\"Exception while querrying customer\",e);",
    "\t\t\tthrow new SecurityDataAccessException(\"Cannot authenticate customer\",e);",
    "\t\t}",
    "",
    "\t\treturn userDetails(userName, user, authorities);",
    "\t}",
    "",
    "}"
  ]
}
