    "package com.salesmanager.shop.store.security;",
    "",
    "import java.io.Serializable;",
    "import java.util.Calendar;",
    "import java.util.Date;",
    "import java.util.HashMap;",
    "import java.util.Map;",
    "import java.util.function.Function;",
    "",
    "import org.springframework.beans.factory.annotation.Value;",
    "import org.springframework.security.core.userdetails.UserDetails;",
    "import org.springframework.stereotype.Component;",
    "",
    "import com.salesmanager.shop.store.security.user.JWTUser;",
    "import com.salesmanager.shop.utils.DateUtil;",
    "",
    "import io.jsonwebtoken.Claims;",
    "import io.jsonwebtoken.Jwts;",
    "import io.jsonwebtoken.SignatureAlgorithm;",
    "",
    "/**",
    " * Used for managing token based authentication for customer and user",
    " * @author c.samson",
    " *",
    " */",
    "@Component",
    "public class JWTTokenUtil implements Serializable {",
    "",
    "\t/**",
    "\t * ",
    "\t */",
    "\tprivate static final long serialVersionUID = 1L;",
    "\t",
    "\t",
    "\t    static final int GRACE_PERIOD = 200;",
    "\t",
    "\t",
    "\t",
    "\t \tstatic final String CLAIM_KEY_USERNAME = \"sub\";",
    "\t    static final String CLAIM_KEY_AUDIENCE = \"aud\";",
    "\t    static final String CLAIM_KEY_CREATED = \"iat\";",
    "",
    "\t    static final String AUDIENCE_UNKNOWN = \"unknown\";",
    "\t    static final String AUDIENCE_API = \"api\";",
    "\t    static final String AUDIENCE_WEB = \"web\";",
    "\t    static final String AUDIENCE_MOBILE = \"mobile\";",
    "\t    static final String AUDIENCE_TABLET = \"tablet\";",
    "",
    "",
    "\t    @Value(\"${jwt.secret}\")",
    "\t    private String secret;",
    "",
    "\t    @Value(\"${jwt.expiration}\")",
    "\t    private Long expiration;",
    "",
    "\t    public String getUsernameFromToken(String token) {",
    "\t        return getClaimFromToken(token, Claims::getSubject);",
    "\t    }",
    "",
    "\t    public Date getIssuedAtDateFromToken(String token) {",
    "\t        return getClaimFromToken(token, Claims::getIssuedAt);",
    "\t    }",
    "",
    "\t    public Date getExpirationDateFromToken(String token) {",
    "\t        return getClaimFromToken(token, Claims::getExpiration);",
    "\t    }",
    "",
    "\t    public String getAudienceFromToken(String token) {",
    "\t        return getClaimFromToken(token, Claims::getAudience);",
    "\t    }",
    "",
    "\t    public <T> T getClaimFromToken(String token, Function<Claims, T> claimsResolver) {",
    "\t        final Claims claims = getAllClaimsFromToken(token);",
    "\t        return claimsResolver.apply(claims);",
    "\t    }",
    "",
    "\t    private Claims getAllClaimsFromToken(String token) {",
    "\t        return Jwts.parser()",
    "\t                .setSigningKey(secret)",
    "\t                .parseClaimsJws(token)",
    "\t                .getBody();",
    "\t    }",
    "",
    "\t    private Boolean isTokenExpired(String token) {",
    "\t        final Date expiration = getExpirationDateFromToken(token);",
    "\t        return expiration.before(DateUtil.getDate());",
    "\t    }",
    "\t    ",
    "\t    private Boolean isTokenExpiredWithGrace(String token) {",
    "\t            Date expiration = getExpirationDateFromToken(token);",
    "\t            expiration = addSeconds(expiration,GRACE_PERIOD);",
    "\t            return expiration.before(DateUtil.getDate());",
    "\t    }",
    "",
    "\t    private Boolean isCreatedBeforeLastPasswordReset(Date created, Date lastPasswordReset) {",
    "\t        return (lastPasswordReset != null && created.before(lastPasswordReset));",
    "\t    }",
    "\t    ",
    "\t    private Boolean isCreatedBeforeLastPasswordResetWithGrace(Date created, Date lastPasswordReset) {",
    "\t        return (lastPasswordReset != null && created.before(addSeconds(lastPasswordReset,GRACE_PERIOD)));",
    "\t    }",
    "\t    ",
    "\t    private Date addSeconds(Date date, Integer seconds) {",
    "\t      Calendar cal = Calendar.getInstance();",
    "\t      cal.setTime(date);",
    "\t      cal.add(Calendar.SECOND, seconds);",
    "\t      return cal.getTime();",
    "\t    }",
    "",
    "\t    private String generateAudience() {",
    "\t        return AUDIENCE_API;",
    "\t    }",
    "",
    "\t    private Boolean ignoreTokenExpiration(String token) {",
    "\t        String audience = getAudienceFromToken(token);",
    "\t        return (AUDIENCE_TABLET.equals(audience) || AUDIENCE_MOBILE.equals(audience));",
    "\t    }",
    "",
    "\t    public String generateToken(UserDetails userDetails) {",
    "\t        Map<String, Object> claims = new HashMap<>();",
    "\t        return doGenerateToken(claims, userDetails.getUsername(), generateAudience());",
    "\t    }",
    "",
    "\t    private String doGenerateToken(Map<String, Object> claims, String subject, String audience) {",
    "\t        final Date createdDate = DateUtil.getDate();",
    "\t        final Date expirationDate = calculateExpirationDate(createdDate);",
    "",
    "\t        System.out.println(\"doGenerateToken \" + createdDate);",
    "",
    "\t        return Jwts.builder()",
    "\t                .setClaims(claims)",
    "\t                .setSubject(subject)",
    "\t                .setAudience(audience)",
    "\t                .setIssuedAt(createdDate)",
    "\t                .setExpiration(expirationDate)",
    "\t                .signWith(SignatureAlgorithm.HS512, secret)",
    "\t                .compact();",
    "\t    }",
    "\t    ",
    "        public Boolean canTokenBeRefreshedWithGrace(String token, Date lastPasswordReset) {",
    "          final Date created = getIssuedAtDateFromToken(token);",
    "          boolean t = isCreatedBeforeLastPasswordResetWithGrace(created, lastPasswordReset);",
    "          boolean u = isTokenExpiredWithGrace(token);",
    "          boolean v =  ignoreTokenExpiration(token);",
    "          System.out.println(t + \" \" +  u + \" \" + v);",
    "          System.out.println(!isCreatedBeforeLastPasswordResetWithGrace(created, lastPasswordReset)",
    "                  && (!isTokenExpiredWithGrace(token) || ignoreTokenExpiration(token)));",
    "          //return !isCreatedBeforeLastPasswordResetWithGrace(created, lastPasswordReset)",
    "          //        && (!isTokenExpired(token) || ignoreTokenExpiration(token));",
    "          return true;",
    "        }\t    ",
    "",
    "\t    public Boolean canTokenBeRefreshed(String token, Date lastPasswordReset) {",
    "\t        final Date created = getIssuedAtDateFromToken(token);",
    "\t        return !isCreatedBeforeLastPasswordReset(created, lastPasswordReset)",
    "\t                && (!isTokenExpired(token) || ignoreTokenExpiration(token));",
    "\t    }",
    "",
    "\t    public String refreshToken(String token) {",
    "\t        final Date createdDate = DateUtil.getDate();",
    "\t        final Date expirationDate = calculateExpirationDate(createdDate);",
    "",
    "\t        final Claims claims = getAllClaimsFromToken(token);",
    "\t        claims.setIssuedAt(createdDate);",
    "\t        claims.setExpiration(expirationDate);",
    "",
    "\t        return Jwts.builder()",
    "\t                .setClaims(claims)",
    "\t                .signWith(SignatureAlgorithm.HS512, secret)",
    "\t                .compact();",
    "\t    }",
    "",
    "\t    public Boolean validateToken(String token, UserDetails userDetails) {",
    "\t        JWTUser user = (JWTUser) userDetails;",
    "\t        final String username = getUsernameFromToken(token);",
    "\t        final Date created = getIssuedAtDateFromToken(token);",
    "\t        //final Date expiration = getExpirationDateFromToken(token);",
    "\t        ",
    "\t        boolean usernameEquals = username.equals(user.getUsername());",
    "\t        boolean isTokenExpired = isTokenExpired(token);",
    "\t        boolean isTokenCreatedBeforeLastPasswordReset = isCreatedBeforeLastPasswordReset(created, user.getLastPasswordResetDate());",
    "\t        ",
    "\t        return (",
    "",
    "\t        \t\tusernameEquals && !isTokenExpired && !isTokenCreatedBeforeLastPasswordReset",
    "\t        );",
    "\t    }",
    "",
    "\t    private Date calculateExpirationDate(Date createdDate) {",
    "\t        return new Date(createdDate.getTime() + expiration * 1000);",
    "\t    }",
    "",
    "}"
  ]
}
