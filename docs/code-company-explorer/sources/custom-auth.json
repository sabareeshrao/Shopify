    "package com.salesmanager.shop.store.security.common;",
    "",
    "import javax.servlet.http.HttpServletRequest;",
    "import javax.servlet.http.HttpServletResponse;",
    "",
    "import org.apache.commons.logging.Log;",
    "import org.apache.commons.logging.LogFactory;",
    "import org.springframework.beans.factory.annotation.Value;",
    "import org.springframework.security.core.Authentication;",
    "import org.springframework.security.core.AuthenticationException;",
    "import org.springframework.security.core.context.SecurityContextHolder;",
    "",
    "/**",
    " * Abstract authentication manager to be used by various internal Authentication manager",
    " * invoked from a SecurityFilter placed in the security filter chain of given http configuration.",
    " * @author c.samson",
    " *",
    " */",
    "public abstract class CustomAuthenticationManager {",
    "\t",
    "\tprotected final Log logger = LogFactory.getLog(getClass());",
    "\t",
    "    @Value(\"${authToken.header}\")",
    "    private String tokenHeader;",
    "",
    "\t",
    "\tpublic String getTokenHeader() {",
    "\t\treturn tokenHeader;",
    "\t}",
    "",
    "\tpublic void setTokenHeader(String tokenHeader) {",
    "\t\tthis.tokenHeader = tokenHeader;",
    "\t}",
    "",
    "\tpublic void authenticateRequest(HttpServletRequest request, HttpServletResponse response) throws Exception {",
    "\t\t",
    "\t\t",
    "\t\tif (logger.isDebugEnabled()) {",
    "\t\t\tlogger.debug(\"Processing authentication\");",
    "\t\t}",
    "\t\t",
    "\t\tAuthentication authResult = null;",
    "",
    "\t\ttry {",
    "\t\t\tauthResult = this.attemptAuthentication(request, response);",
    "\t\t\tif (authResult == null) {",
    "\t\t\t\t// return immediately as subclass has indicated that it hasn't completed",
    "\t\t\t\t// authentication",
    "\t\t\t\treturn;",
    "\t\t\t}",
    "\t\t} catch (AuthenticationException failed) {",
    "\t\t\t// Authentication failed",
    "\t\t\tunsuccess(request, response);",
    "\t\t\treturn;",
    "\t\t}",
    "",
    "\t\tthis.success(request, response, authResult);",
    "",
    "\t\t",
    "\t}",
    "\t",
    "\tprivate void success(HttpServletRequest request, HttpServletResponse response, Authentication authentication) throws AuthenticationException {",
    "",
    "\t\tSecurityContextHolder.getContext().setAuthentication(authentication);",
    "\t\t",
    "\t\tif (logger.isDebugEnabled()) {",
    "\t\t\tlogger.debug(\"Authentication success\");",
    "\t\t\tlogger.debug(\"Updated SecurityContextHolder to containAuthentication\");",
    "\t\t}",
    "\t\t",
    "\t\tsuccessfullAuthentication(request, response, authentication);",
    "\t}",
    "\t",
    "\tprivate void unsuccess(HttpServletRequest request, HttpServletResponse response) throws AuthenticationException {",
    "",
    "\t\tSecurityContextHolder.clearContext();",
    "\t\t",
    "\t\tif (logger.isDebugEnabled()) {",
    "\t\t\tlogger.debug(\"Authentication request failed\");",
    "\t\t\tlogger.debug(\"Updated SecurityContextHolder to contain null Authentication\");",
    "\t\t}",
    "\t\t",
    "\t\tunSuccessfullAuthentication(request, response);",
    "\t}",
    "",
    "\t",
    "\tpublic abstract Authentication attemptAuthentication(HttpServletRequest request, HttpServletResponse response) throws AuthenticationException, Exception;",
    "\t",
    "\tpublic abstract void successfullAuthentication(HttpServletRequest request, HttpServletResponse response, Authentication authentication) throws AuthenticationException;",
    "",
    "\tpublic abstract void unSuccessfullAuthentication(HttpServletRequest request, HttpServletResponse response) throws AuthenticationException;",
    "",
    "}"
  ]
}
