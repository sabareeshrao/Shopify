    "@Service(\"userDetailsService\")",
    "public class UserServicesImpl implements WebUserServices{",
    "\t",
    "\tprivate static final Logger LOGGER = LoggerFactory.getLogger(UserServicesImpl.class);",
    "\t",
    "\tprivate static final String DEFAULT_INITIAL_PASSWORD = \"password\";",
    "",
    "\t@Inject",
    "\tprivate UserService userService;",
    "\t",
    "",
    "\t@Inject",
    "\tprivate MerchantStoreService merchantStoreService;",
    "\t",
    "\t@Inject",
    "\t@Named(\"passwordEncoder\")",
    "\tprivate PasswordEncoder passwordEncoder;",
    "\t",
    "",
    "\t",
    "\t@Inject",
    "\tprotected PermissionService  permissionService;",
    "\t",
    "\t@Inject",
    "\tprotected GroupService   groupService;",
    "\t",
    "\tpublic final static String ROLE_PREFIX = \"ROLE_\";",
    "\t",
    "\t",
    "\t",
    "\tpublic UserDetails loadUserByUsername(String userName)",
    "\t\t\tthrows UsernameNotFoundException, DataAccessException {",
    "",
    "\t\tcom.salesmanager.core.model.user.User user = null;",
    "\t\tCollection<GrantedAuthority> authorities = new ArrayList<GrantedAuthority>();",
    "\t\t",
    "\t\ttry {",
    "",
    "\t\t\tuser = userService.getByUserName(userName);",
    "",
    "\t\t\tif(user==null) {",
    "\t\t\t\treturn null;",
    "\t\t\t}",
    "",
    "\t\t\tGrantedAuthority role = new SimpleGrantedAuthority(ROLE_PREFIX + Constants.PERMISSION_AUTHENTICATED);//required to login",
    "\t\t\tauthorities.add(role);",
    "\t",
    "\t\t\tList<Integer> groupsId = new ArrayList<Integer>();",
    "\t\t\tList<Group> groups = user.getGroups();",
    "\t\t\tfor(Group group : groups) {",
    "\t\t\t\t",
    "\t\t\t\t",
    "\t\t\t\tgroupsId.add(group.getId());",
    "\t\t\t\t",
    "\t\t\t}",
    "\t\t\t",
    "\t",
    "\t    \t",
    "\t    \tList<Permission> permissions = permissionService.getPermissions(groupsId);",
    "\t    \tfor(Permission permission : permissions) {",
    "\t    \t\tGrantedAuthority auth = new SimpleGrantedAuthority(ROLE_PREFIX + permission.getPermissionName());",
    "\t    \t\tauthorities.add(auth);",
    "\t    \t}",
    "    \t",
    "\t\t} catch (Exception e) {",
    "\t\t\tLOGGER.error(\"Exception while querrying user\",e);",
    "\t\t\tthrow new SecurityDataAccessException(\"Exception while querrying user\",e);",
    "\t\t}",
    "\t\t",
    "\t\t",
    "\t\t",
    "\t",
    "\t\t",
    "\t\tUser secUser = new User(userName, user.getAdminPassword(), user.isActive(), true,",
    "\t\t\t\ttrue, true, authorities);",
    "\t\treturn secUser;",
    "\t}",
    "\t",
    "\t",
    "\tpublic void createDefaultAdmin() throws Exception {",
    "",
    "\t\t  MerchantStore store = merchantStoreService.getByCode(MerchantStore.DEFAULT_STORE);",
    "",
    "\t\t  String password = passwordEncoder.encode(DEFAULT_INITIAL_PASSWORD);",
    "\t\t  ",
    "\t\t  List<Group> groups = groupService.listGroup(GroupType.ADMIN);",
    "\t\t  ",
    "\t\t  //creation of the super admin admin:password)",
    "\t\t  com.salesmanager.core.model.user.User user = new com.salesmanager.core.model.user.User(\"admin@shopizer.com\",password,\"admin@shopizer.com\");",
    "\t\t  user.setFirstName(\"Administrator\");",
    "\t\t  user.setLastName(\"User\");",
    "\t\t  ",
    "\t\t  for(Group group : groups) {",
    "\t\t\t  if(group.getGroupName().equals(Constants.GROUP_SUPERADMIN) || group.getGroupName().equals(Constants.GROUP_ADMIN)) {",
    "\t\t\t\t  user.getGroups().add(group);",
    "\t\t\t  }",
    "\t\t  }",
    "",
    "\t\t  user.setMerchantStore(store);\t\t  ",
    "\t\t  userService.create(user);",
    "\t\t",
    "\t\t",
    "\t}",
    "",
    "",
    "",
    "}"
