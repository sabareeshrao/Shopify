    "package com.salesmanager.shop.store.security.user;",
    "",
    "import java.util.Collection;",
    "",
    "import org.springframework.security.core.GrantedAuthority;",
    "import org.springframework.security.core.userdetails.User;",
    "",
    "public class CustomerDetails extends User {",
    "",
    "\t/**",
    "\t * ",
    "\t */",
    "\tprivate static final long serialVersionUID = 1L;",
    "\t",
    "\tprivate String email;",
    "\tprivate Long id;",
    "\tprivate String firstName;",
    "\tprivate String lastName;",
    "",
    "\tpublic CustomerDetails(",
    "\t\t\tString username, ",
    "\t\t\tString password, ",
    "\t\t\tboolean enabled, ",
    "\t\t\tboolean accountNonExpired,",
    "\t\t\tboolean credentialsNonExpired, ",
    "\t\t\tboolean accountNonLocked,",
    "\t\t\tCollection<? extends GrantedAuthority> authorities) {",
    "\t\tsuper(username, password, enabled, accountNonExpired, credentialsNonExpired, accountNonLocked, authorities);",
    "\t}",
    "\t",
    "\tpublic CustomerDetails(",
    "\t\t\tString username, ",
    "\t\t\tString password, ",
    "\t\t\tCollection<? extends GrantedAuthority> authorities) {",
    "\t\tsuper(username, password, true, true, true, true, authorities);",
    "\t}",
    "",
    "\tpublic String getEmail() {",
    "\t\treturn email;",
    "\t}",
    "",
    "\tpublic void setEmail(String email) {",
    "\t\tthis.email = email;",
    "\t}",
    "",
    "\tpublic Long getId() {",
    "\t\treturn id;",
    "\t}",
    "",
    "\tpublic void setId(Long id) {",
    "\t\tthis.id = id;",
    "\t}",
    "",
    "\tpublic String getFirstName() {",
    "\t\treturn firstName;",
    "\t}",
    "",
    "\tpublic void setFirstName(String firstName) {",
    "\t\tthis.firstName = firstName;",
    "\t}",
    "",
    "\tpublic String getLastName() {",
    "\t\treturn lastName;",
    "\t}",
    "",
    "\tpublic void setLastName(String lastName) {",
    "\t\tthis.lastName = lastName;",
    "\t}",
    "",
    "}"
