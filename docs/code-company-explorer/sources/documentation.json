    "package com.salesmanager.shop.application.config;",
    "",
    "import static io.swagger.models.auth.In.HEADER;",
    "import static java.util.Collections.singletonList;",
    "import static org.springframework.http.HttpHeaders.AUTHORIZATION;",
    "",
    "import java.util.ArrayList;",
    "import java.util.Collections;",
    "import java.util.HashSet;",
    "import java.util.List;",
    "import java.util.Set;",
    "import java.util.stream.Collectors;",
    "import java.util.stream.Stream;",
    "",
    "import org.springframework.context.annotation.Bean;",
    "import org.springframework.context.annotation.Configuration;",
    "import org.springframework.web.bind.annotation.RequestMethod;",
    "",
    "import com.google.common.base.Predicate;",
    "import com.google.common.base.Predicates;",
    "",
    "import springfox.documentation.RequestHandler;",
    "import springfox.documentation.builders.RequestHandlerSelectors;",
    "import springfox.documentation.builders.ResponseMessageBuilder;",
    "import springfox.documentation.schema.ModelRef;",
    "import springfox.documentation.service.ApiInfo;",
    "import springfox.documentation.service.ApiKey;",
    "import springfox.documentation.service.AuthorizationScope;",
    "import springfox.documentation.service.Contact;",
    "import springfox.documentation.service.ResponseMessage;",
    "import springfox.documentation.service.SecurityReference;",
    "import springfox.documentation.service.SecurityScheme;",
    "import springfox.documentation.service.VendorExtension;",
    "import springfox.documentation.spi.DocumentationType;",
    "import springfox.documentation.spi.service.contexts.SecurityContext;",
    "import springfox.documentation.spring.web.plugins.Docket;",
    "import springfox.documentation.swagger2.annotations.EnableSwagger2;",
    "",
    "@Configuration",
    "@EnableSwagger2",
    "public class DocumentationConfiguration {",
    "",
    "\tpublic static final Contact DEFAULT_CONTACT = new Contact(\"Shopizer\", \"https://www.shopizer.com\", \"\");",
    "\t",
    "\tprivate static final String HOST = \"localhost:8080\";",
    "",
    "\t/**",
    "\t * http://localhost:8080/swagger-ui.html#/ http://localhost:8080/v2/api-docs",
    "\t */",
    "",
    "\t@Bean",
    "\tpublic Docket api() {",
    "",
    "\t\tfinal List<ResponseMessage> getMessages = new ArrayList<ResponseMessage>();",
    "\t\tgetMessages.add(new ResponseMessageBuilder().code(500).message(\"500 message\")",
    "\t\t\t\t.responseModel(new ModelRef(\"Error\")).build());",
    "\t\tgetMessages.add(new ResponseMessageBuilder().code(403).message(\"Forbidden\").build());",
    "\t\tgetMessages.add(new ResponseMessageBuilder().code(401).message(\"Unauthorized\").build());",
    "",
    "\t\tSet<String> produces = new HashSet<>();",
    "\t\tproduces.add(\"application/json\");",
    "",
    "\t\tSet<String> consumes = new HashSet<>();",
    "\t\tconsumes.add(\"application/json\");",
    "",
    "\t\treturn new Docket(DocumentationType.SWAGGER_2)",
    "\t\t\t\t.host(HOST)",
    "\t\t\t\t.select()",
    "\t\t\t\t.apis(requestHandlers()).build()",
    "\t\t\t\t.securitySchemes(Collections.singletonList(new ApiKey(\"JWT\", AUTHORIZATION, HEADER.name())))",
    "\t\t        .securityContexts(singletonList(",
    "\t\t            SecurityContext.builder()",
    "\t\t                .securityReferences(",
    "\t\t                    singletonList(SecurityReference.builder()",
    "\t\t                        .reference(\"JWT\")",
    "\t\t                        .scopes(new AuthorizationScope[0])",
    "\t\t                        .build()",
    "\t\t                    )",
    "\t\t                )",
    "\t\t                .build())",
    "\t\t        )",
    "\t\t\t\t.produces(produces).consumes(consumes).globalResponseMessage(RequestMethod.GET, getMessages)",
    "\t            .globalResponseMessage(RequestMethod.GET, getMessages);",
    "",
    "\t}",
    "\t",
    "\tfinal Predicate<RequestHandler> requestHandlers() {",
    "\t\t",
    "\t\t   Set<Predicate<RequestHandler>> matchers = new HashSet<Predicate<RequestHandler>>();",
    "\t\t   matchers.add(RequestHandlerSelectors.basePackage(\"com.salesmanager.shop.store.api.v1\"));",
    "\t\t   matchers.add(RequestHandlerSelectors.basePackage(\"com.salesmanager.shop.store.api.v2\"));",
    "\t\t   ",
    "\t\t   return Predicates.or(matchers);",
    "",
    "\t}",
    "",
    "\t@SuppressWarnings(\"rawtypes\")",
    "\tprivate ApiInfo apiInfo() {",
    "\t\treturn new ApiInfo(\"Shopizer REST API\",",
    "\t\t\t\t\"API for Shopizer e-commerce. Contains public end points as well as private end points requiring basic authentication and remote authentication based on jwt bearer token. URL patterns containing /private/** use bearer token; those are authorized customer and administrators administration actions.\",",
    "\t\t\t\t\"1.0\", \"urn:tos\", DEFAULT_CONTACT, \"Apache 2.0\", \"http://www.apache.org/licenses/LICENSE-2.0\",",
    "\t\t\t\tnew ArrayList<VendorExtension>());",
    "",
    "\t}",
    "",
    "\tprivate static ArrayList<? extends SecurityScheme> securitySchemes() {",
    "\t\treturn (ArrayList<? extends SecurityScheme>) Stream.of(new ApiKey(\"Bearer\", \"Authorization\", \"header\"))",
    "\t\t\t\t.collect(Collectors.toList());",
    "\t}",
    "",
    "}"
  ]
}
