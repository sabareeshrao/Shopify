    "package com.salesmanager.shop.application.config;",
    "",
    "import org.springframework.beans.factory.annotation.Autowired;",
    "import org.springframework.context.annotation.Bean;",
    "import org.springframework.context.annotation.Configuration;",
    "import org.springframework.core.annotation.Order;",
    "import org.springframework.http.HttpMethod;",
    "import org.springframework.security.authentication.AuthenticationManager;",
    "import org.springframework.security.authentication.AuthenticationProvider;",
    "import org.springframework.security.config.annotation.authentication.builders.AuthenticationManagerBuilder;",
    "import org.springframework.security.config.annotation.web.builders.HttpSecurity;",
    "import org.springframework.security.config.annotation.web.builders.WebSecurity;",
    "import org.springframework.security.config.annotation.web.configuration.EnableWebSecurity;",
    "import org.springframework.security.config.annotation.web.configuration.WebSecurityConfigurerAdapter;",
    "import org.springframework.security.core.userdetails.UserDetailsService;",
    "import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;",
    "import org.springframework.security.crypto.password.PasswordEncoder;",
    "import org.springframework.security.web.AuthenticationEntryPoint;",
    "import org.springframework.security.web.authentication.www.BasicAuthenticationEntryPoint;",
    "import org.springframework.security.web.authentication.www.BasicAuthenticationFilter;",
    "",
    "import com.salesmanager.shop.admin.security.UserAuthenticationSuccessHandler;",
    "import com.salesmanager.shop.admin.security.WebUserServices;",
    "import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;",
    "import com.salesmanager.shop.store.security.AuthenticationTokenFilter;",
    "import com.salesmanager.shop.store.security.ServicesAuthenticationSuccessHandler;",
    "import com.salesmanager.shop.store.security.admin.JWTAdminAuthenticationProvider;",
    "import com.salesmanager.shop.store.security.admin.JWTAdminServicesImpl;",
    "import com.salesmanager.shop.store.security.customer.JWTCustomerAuthenticationProvider;",
    "import com.salesmanager.shop.store.security.services.CredentialsService;",
    "import com.salesmanager.shop.store.security.services.CredentialsServiceImpl;",
    "",
    "/**",
    " * Main entry point for security - admin - customer - auth - private - services",
    " * ",
    " * @author dur9213",
    " *",
    " */",
    "@Configuration",
    "@EnableWebSecurity",
    "public class MultipleEntryPointsSecurityConfig {",
    "",
    "\tprivate static final String API_VERSION = \"/api/v*\";",
    "",
    "\t@Bean",
    "\tpublic AuthenticationTokenFilter authenticationTokenFilter() {",
    "\t\treturn new AuthenticationTokenFilter();",
    "\t}",
    "\t",
    "\t@Bean",
    "\tpublic CredentialsService credentialsService() {",
    "\t\treturn new CredentialsServiceImpl();",
    "\t}",
    "",
    "\t@Bean",
    "\tpublic PasswordEncoder passwordEncoder() {",
    "\t\treturn new BCryptPasswordEncoder();",
    "\t}",
    "",
    "\t@Bean",
    "\tpublic UserAuthenticationSuccessHandler userAuthenticationSuccessHandler() {",
    "\t\treturn new UserAuthenticationSuccessHandler();",
    "\t}",
    "",
    "\t@Bean",
    "\tpublic ServicesAuthenticationSuccessHandler servicesAuthenticationSuccessHandler() {",
    "\t\treturn new ServicesAuthenticationSuccessHandler();",
    "\t}",
    "",
    "\t@Bean",
    "\tpublic CustomerFacade customerFacade() {",
    "\t\treturn new com.salesmanager.shop.store.controller.customer.facade.CustomerFacadeImpl();",
    "\t}",
    "",
    "\t",
    "\t",
    "\t/**",
    "\t * shop / customer",
    "\t * ",
    "\t * @author dur9213",
    "\t *",
    "\t */",
    "\t@Configuration",
    "\t@Order(1)",
    "\tpublic static class CustomerConfigurationAdapter extends WebSecurityConfigurerAdapter {",
    "",
    "\t\t@Bean(\"customerAuthenticationManager\")",
    "\t\t@Override",
    "\t\tpublic AuthenticationManager authenticationManagerBean() throws Exception {",
    "\t\t\treturn super.authenticationManagerBean();",
    "\t\t}",
    "",
    "\t\t@Autowired",
    "\t\tprivate UserDetailsService customerDetailsService;",
    "",
    "\t\tpublic CustomerConfigurationAdapter() {",
    "\t\t\tsuper();",
    "\t\t}",
    "\t\t",
    "\t\t@Override",
    "\t\tpublic void configure(WebSecurity web) {",
    "\t\t\tweb.ignoring().antMatchers(\"/\");",
    "\t\t\tweb.ignoring().antMatchers(\"/error\");",
    "\t\t\tweb.ignoring().antMatchers(\"/resources/**\");",
    "\t\t\tweb.ignoring().antMatchers(\"/static/**\");",
    "\t\t\tweb.ignoring().antMatchers(\"/services/public/**\");",
    "\t\t}",
    "",
    "",
    "\t\t@Override",
    "\t\tpublic void configure(AuthenticationManagerBuilder auth) throws Exception {",
    "\t\t\tauth.userDetailsService(customerDetailsService);",
    "\t\t}",
    "",
    "\t\t@Override",
    "\t\tprotected void configure(HttpSecurity http) throws Exception {",
    "\t\t\thttp",
    "\t\t\t.antMatcher(\"/shop/**\")",
    "\t\t\t.csrf().disable()\t\t\t",
    "\t\t\t.authorizeRequests()",
    "\t\t\t\t\t.antMatchers(\"/shop/\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/shop/**\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/shop/customer/logon*\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/shop/customer/registration*\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/shop/customer/logout*\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/shop/customer/customLogon*\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/shop/customer/denied*\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/shop/customer/**\").hasRole(\"AUTH_CUSTOMER\")",
    "\t\t\t\t\t.anyRequest().authenticated()",
    "\t\t\t\t\t.and()",
    "\t\t\t\t\t.httpBasic()",
    "\t\t\t\t\t.authenticationEntryPoint(shopAuthenticationEntryPoint())",
    "\t\t\t\t\t.and()",
    "\t\t\t\t\t.logout()",
    "\t\t\t\t\t.logoutUrl(\"/shop/customer/logout\")",
    "\t\t\t\t\t.logoutSuccessUrl(\"/shop/\")",
    "\t\t\t\t\t.invalidateHttpSession(true)",
    "\t\t\t\t\t.deleteCookies(\"JSESSIONID\")",
    "",
    "\t\t\t\t\t.invalidateHttpSession(false)",
    "\t\t\t\t\t.and()",
    "\t\t\t\t\t.exceptionHandling().accessDeniedPage(\"/shop/\");",
    "",
    "\t\t}",
    "",
    "\t\t@Bean",
    "\t\tpublic AuthenticationEntryPoint shopAuthenticationEntryPoint() {",
    "\t\t\tBasicAuthenticationEntryPoint entryPoint = new BasicAuthenticationEntryPoint();",
    "\t\t\tentryPoint.setRealmName(\"shop-realm\");",
    "\t\t\treturn entryPoint;",
    "\t\t}",
    "",
    "\t}",
    "\t",
    "\t/**",
    "\t * services api v0",
    "\t * ",
    "\t * @author dur9213",
    "\t * @deprecated",
    "\t *",
    "\t */",
    "\t@Configuration",
    "\t@Order(2)",
    "\tpublic static class ServicesApiConfigurationAdapter extends WebSecurityConfigurerAdapter {",
    "",
    "\t\t@Autowired",
    "\t\tprivate WebUserServices userDetailsService;",
    "",
    "\t\t@Autowired",
    "\t\tprivate ServicesAuthenticationSuccessHandler servicesAuthenticationSuccessHandler;",
    "",
    "\t\tpublic ServicesApiConfigurationAdapter() {",
    "\t\t\tsuper();",
    "\t\t}",
    "",
    "\t\t@Override",
    "\t\tpublic void configure(AuthenticationManagerBuilder auth) throws Exception {",
    "\t\t\tauth.userDetailsService(userDetailsService);",
    "\t\t}",
    "",
    "\t\t@Override",
    "\t\tprotected void configure(HttpSecurity http) throws Exception {",
    "\t\t\thttp",
    "\t\t\t.antMatcher(\"/services/**\")",
    "\t\t\t.csrf().disable()",
    "\t\t\t\t\t.authorizeRequests()",
    "\t\t\t\t\t.antMatchers(\"/services/public/**\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/services/private/**\").hasRole(\"AUTH\")",
    "\t\t\t\t\t.anyRequest().authenticated()",
    "\t\t\t\t\t.and().httpBasic().authenticationEntryPoint(servicesAuthenticationEntryPoint())",
    "\t\t\t\t\t.and().formLogin()",
    "\t\t\t\t\t.successHandler(servicesAuthenticationSuccessHandler);",
    "",
    "\t\t}",
    "",
    "\t\t@Bean",
    "\t\tpublic AuthenticationEntryPoint servicesAuthenticationEntryPoint() {",
    "\t\t\tBasicAuthenticationEntryPoint entryPoint = new BasicAuthenticationEntryPoint();",
    "\t\t\tentryPoint.setRealmName(\"rest-customer-realm\");",
    "\t\t\treturn entryPoint;",
    "\t\t}",
    "",
    "\t}",
    "",
    "\t/**",
    "\t * admin",
    "\t * ",
    "\t * @author dur9213",
    "\t *",
    "\t */",
    "\t/**",
    "\t@Configuration",
    "\t@Order(3)",
    "\tpublic static class AdminConfigurationAdapter extends WebSecurityConfigurerAdapter {",
    "",
    "\t\t@Autowired",
    "\t\tprivate WebUserServices userDetailsService;",
    "",
    "\t\t@Autowired",
    "\t\tprivate UserAuthenticationSuccessHandler userAuthenticationSuccessHandler;",
    "",
    "\t\tpublic AdminConfigurationAdapter() {",
    "\t\t\tsuper();",
    "\t\t}",
    "",
    "\t\t@Override",
    "\t\tpublic void configure(AuthenticationManagerBuilder auth) throws Exception {",
    "\t\t\tauth.userDetailsService(userDetailsService);",
    "\t\t}",
    "\t\t",
    "\t\t@Override",
    "\t\tpublic void configure(WebSecurity web) {",
    "\t\t}",
    "",
    "\t\t@Override",
    "\t\tprotected void configure(HttpSecurity http) throws Exception {",
    "\t\t\thttp",
    "\t\t\t.antMatcher(\"/admin/**\")",
    "\t\t\t\t\t.authorizeRequests()",
    "\t\t\t\t\t.antMatchers(\"/admin/logon*\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/admin/resources/**\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/admin/layout/**\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/admin/denied*\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/admin/unauthorized*\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/admin/users/resetPassword*\").permitAll()",
    "\t\t\t\t\t.antMatchers(\"/admin/\").hasRole(\"AUTH\")",
    "\t\t\t\t\t.antMatchers(\"/admin/**\").hasRole(\"AUTH\")",
    "\t\t\t\t\t.antMatchers(\"/admin/**\").hasRole(\"AUTH\")",
    "\t\t\t\t\t.antMatchers(\"/admin/users/resetPasswordSecurityQtn*\").permitAll()",
    "\t\t\t\t\t.anyRequest()",
    "\t\t\t\t\t.authenticated()",
    "\t\t\t\t\t.and()",
    "\t\t\t\t\t.httpBasic()",
    "\t\t\t\t\t.authenticationEntryPoint(adminAuthenticationEntryPoint())",
    "\t\t\t\t\t.and()",
    "\t\t\t\t\t.formLogin().usernameParameter(\"username\").passwordParameter(\"password\")",
    "\t\t\t\t\t.loginPage(\"/admin/logon.html\")",
    "\t\t\t\t\t.loginProcessingUrl(\"/admin/performUserLogin\")",
    "\t\t\t\t\t.successHandler(userAuthenticationSuccessHandler)",
    "\t\t\t\t\t.failureUrl(\"/admin/logon.html?login_error=true\")",
    "\t\t\t\t\t.and()",
    "\t\t\t\t\t.csrf().disable()",
    "\t\t\t\t\t.logout().logoutUrl(\"/admin/logout\").logoutSuccessUrl(\"/admin/home.html\")",
    "\t\t\t\t\t.invalidateHttpSession(true).and().exceptionHandling().accessDeniedPage(\"/admin/denied.html\");",
    "\t\t\t",
    "",
    "\t\t}",
    "",
    "\t\t@Bean",
    "\t\tpublic AuthenticationEntryPoint adminAuthenticationEntryPoint() {",
    "\t\t\tBasicAuthenticationEntryPoint entryPoint = new BasicAuthenticationEntryPoint();",
    "\t\t\tentryPoint.setRealmName(\"admin-realm\");",
    "\t\t\treturn entryPoint;",
    "\t\t}",
    "",
    "\t}",
    "\t**/",
    "",
    "\t/**",
    "\t * api - private",
    "\t * ",
    "\t * @author dur9213",
    "\t *",
    "\t */",
    "\t@Configuration",
    "\t@Order(5)",
    "\tpublic static class UserApiConfigurationAdapter extends WebSecurityConfigurerAdapter {",
    "",
    "\t\t@Autowired",
    "\t\tprivate AuthenticationTokenFilter authenticationTokenFilter;",
    "",
    "\t\t@Autowired",
    "\t\tJWTAdminServicesImpl jwtUserDetailsService;",
    "",
    "\t\t@Bean(\"jwtAdminAuthenticationManager\")",
    "\t\t@Override",
    "\t\tpublic AuthenticationManager authenticationManagerBean() throws Exception {",
    "\t\t\tAuthenticationManager mgr = super.authenticationManagerBean();",
    "\t\t\treturn mgr;",
    "\t\t}",
    "\t\t",
    "\t\t",
    "",
    "\t\tpublic UserApiConfigurationAdapter() {",
    "\t\t\tsuper();",
    "\t\t}",
    "",
    "\t\t@Override",
    "\t\tpublic void configure(AuthenticationManagerBuilder auth) throws Exception {",
    "\t\t       auth.userDetailsService(jwtUserDetailsService)",
    "\t            .and()",
    "\t            .authenticationProvider(authenticationProvider());",
    "\t\t}",
    "\t\t",
    "\t\t@Override",
    "\t\tpublic void configure(WebSecurity web) {",
    "\t\t\tweb.ignoring().antMatchers(\"/swagger-ui.html\");",
    "\t\t}",
    "",
    "\t\t",
    "\t\t/**",
    "\t\t * Admin user api",
    "\t\t */",
    "\t\t@Override",
    "\t\tprotected void configure(HttpSecurity http) throws Exception {",
    "\t\t\thttp",
    "\t\t\t\t\t.antMatcher(API_VERSION + \"/private/**\")",
    "\t\t\t\t\t.authorizeRequests()",
    "\t\t\t\t\t.antMatchers(API_VERSION + \"/private/login*\").permitAll()",
    "\t\t\t\t\t.antMatchers(API_VERSION + \"/private/refresh\").permitAll()",
    "\t\t\t\t\t.antMatchers(HttpMethod.OPTIONS, API_VERSION + \"/private/**\").permitAll()",
    "\t\t\t\t\t.antMatchers(API_VERSION + \"/private/**\").hasRole(\"AUTH\")",
    "\t\t\t\t\t.anyRequest().authenticated()",
    "\t\t\t\t\t.and()",
    "\t\t\t\t\t.httpBasic().authenticationEntryPoint(apiAdminAuthenticationEntryPoint())",
    "\t\t\t\t\t.and()",
    "\t\t\t\t\t.addFilterAfter(authenticationTokenFilter, BasicAuthenticationFilter.class)",
    "\t\t\t\t\t.csrf().disable();",
    "",
    "\t\t}",
    "\t\t",
    "\t    @Bean",
    "\t    public AuthenticationProvider authenticationProvider() {",
    "\t    \tJWTAdminAuthenticationProvider provider = new JWTAdminAuthenticationProvider();",
    "\t        provider.setUserDetailsService(jwtUserDetailsService);",
    "\t        return provider;",
    "\t    }",
    "",
    "\t\t@Bean",
    "\t\tpublic AuthenticationEntryPoint apiAdminAuthenticationEntryPoint() {",
    "\t\t\tBasicAuthenticationEntryPoint entryPoint = new BasicAuthenticationEntryPoint();",
    "\t\t\tentryPoint.setRealmName(\"api-admin-realm\");",
    "\t\t\treturn entryPoint;",
    "\t\t}",
    "",
    "\t}",
    "",
    "",
    "",
    "\t/**",
    "\t * customer api",
    "\t * ",
    "\t * @author dur9213",
    "\t *",
    "\t */",
    "\t@Configuration",
    "\t@Order(6)",
    "\tpublic static class CustomeApiConfigurationAdapter extends WebSecurityConfigurerAdapter {",
    "",
    "\t\t@Autowired",
    "\t\tprivate AuthenticationTokenFilter authenticationTokenFilter;",
    "",
    "\t\t@Autowired",
    "\t\tprivate UserDetailsService jwtCustomerDetailsService;",
    "",
    "\t\tpublic CustomeApiConfigurationAdapter() {",
    "\t\t\tsuper();",
    "\t\t}",
    "\t\t",
    "\t\t@Bean(\"jwtCustomerAuthenticationManager\")",
    "\t\t@Override",
    "\t\tpublic AuthenticationManager authenticationManagerBean() throws Exception {",
    "\t\t\treturn super.authenticationManagerBean();",
    "\t\t}",
    "",
    "\t\t@Override",
    "\t\tpublic void configure(AuthenticationManagerBuilder auth) throws Exception {",
    "\t\t\tauth.userDetailsService(jwtCustomerDetailsService);",
    "\t\t}",
    "",
    "\t\t@Override",
    "\t\tprotected void configure(HttpSecurity http) throws Exception {",
    "\t\t\thttp",
    "\t\t\t",
    "\t\t\t\t.antMatcher(API_VERSION + \"/auth/**\")",
    "\t\t\t\t.authorizeRequests()",
    "\t\t\t\t\t.antMatchers(API_VERSION + \"/auth/refresh\").permitAll()",
    "\t\t\t\t\t.antMatchers(API_VERSION + \"/auth/login\").permitAll()",
    "\t\t\t\t\t.antMatchers(API_VERSION + \"/auth/register\").permitAll()",
    "\t\t\t\t\t.antMatchers(HttpMethod.OPTIONS, API_VERSION + \"/auth/**\").permitAll()",
    "\t\t\t\t\t.antMatchers(API_VERSION + \"/auth/**\")",
    "\t\t\t\t\t.hasRole(\"AUTH_CUSTOMER\").anyRequest().authenticated()",
    "\t\t\t\t\t.and()",
    "\t\t\t\t\t.httpBasic()",
    "\t\t\t\t\t.authenticationEntryPoint(apiCustomerAuthenticationEntryPoint()).and().csrf().disable()",
    "\t\t\t\t\t.addFilterAfter(authenticationTokenFilter, BasicAuthenticationFilter.class);",
    "",
    "\t\t}",
    "\t\t",
    "\t    @Bean",
    "\t    public AuthenticationProvider authenticationProvider() {",
    "\t    \tJWTCustomerAuthenticationProvider provider = new JWTCustomerAuthenticationProvider();",
    "\t        provider.setUserDetailsService(jwtCustomerDetailsService);",
    "\t        return provider;",
    "\t    }",
    "",
    "\t\t@Bean",
    "\t\tpublic AuthenticationEntryPoint apiCustomerAuthenticationEntryPoint() {",
    "\t\t\tBasicAuthenticationEntryPoint entryPoint = new BasicAuthenticationEntryPoint();",
    "\t\t\tentryPoint.setRealmName(\"api-customer-realm\");",
    "\t\t\treturn entryPoint;",
    "\t\t}",
    "",
    "\t}",
    "",
    "",
    "",
    "}"
